# Template file for 'uniplan'
pkgname=uniplan
version=0.0.1
revision=1
archs="x86_64* aarch64*"
build_style=meta
hostmakedepends="binutils"
short_desc="An all-in-one academic planner for students"
maintainer="dStudios <david@dstudios.org>"
license="Proprietary"
homepage="https://uniplan.dstudios.org"
distfiles="https://github.com/dStudios-735453/UniPlan_Releases/releases/download/v20.05.2026-1728_linux/Uniplan_0.0.1_amd64.deb"
checksum=b1bcf9ad3a49b2cd7d066acbf97725ca579a422d3ca6189300559f4672c50978
nostrip=yes
nopie=yes

case "${XBPS_TARGET_MACHINE}" in
	aarch64*)
		_deb_suffix="arm64"
		distfiles="https://github.com/x"
		checksum="x"
		;;
	*)
		_deb_suffix="amd64"
		;;
esac

do_install() {
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/Uniplan_0.0.1_${_deb_suffix}.deb .
	ar x Uniplan_0.0.1_${_deb_suffix}.deb
	tar xf data.tar.*

	vbin usr/bin/uniplan
	vinstall ${FILESDIR}/uniplan.desktop 644 usr/share/applications/
	vinstall ${FILESDIR}/org.dstudios.uniplan.png 644 usr/share/icons/hicolor/512x512/apps/
	vinstall ${FILESDIR}/org.dstudios.uniplan.metainfo.xml 644 usr/share/metainfo/
	vinstall ${FILESDIR}/LICENSE 644 usr/share/licenses/uniplan/
}